{
  "info": {
    "name": "TaskFlow Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "TaskFlow backend collection for auth, project, task, member, and job endpoints"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {"name": "Register", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": {"raw": "http://localhost:5000/api/auth/register", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "auth", "register"]}, "body": {"mode": "raw", "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"StrongPassword123!\",\n  \"organizationName\": \"Acme Inc\"\n}"}}},
        {"name": "Login", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": {"raw": "http://localhost:5000/api/auth/login", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "auth", "login"]}, "body": {"mode": "raw", "raw": "{\n  \"email\": \"jane@example.com\",\n  \"password\": \"StrongPassword123!\"\n}"}}},
        {"name": "Refresh", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": {"raw": "http://localhost:5000/api/auth/refresh", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "auth", "refresh"]}, "body": {"mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"}}},
        {"name": "Logout", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": {"raw": "http://localhost:5000/api/auth/logout", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "auth", "logout"]}, "body": {"mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"}}}
      ]
    },
    {
      "name": "Projects",
      "item": [
        {"name": "List Projects", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": {"raw": "http://localhost:5000/api/projects", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "projects"]}}},
        {"name": "Create Project", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": {"raw": "http://localhost:5000/api/projects", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "projects"]}, "body": {"mode": "raw", "raw": "{\n  \"name\": \"New Project\",\n  \"description\": \"Project description\"\n}"}}}
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {"name": "List Tasks", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": {"raw": "http://localhost:5000/api/tasks/projects/{{projectId}}?page=1&limit=20", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "tasks", "projects", "{{projectId}}"], "query": [{"key": "page", "value": "1"}, {"key": "limit", "value": "20"}]}}},
        {"name": "Create Task", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{accessToken}}"}], "url": {"raw": "http://localhost:5000/api/tasks/projects/{{projectId}}", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "tasks", "projects", "{{projectId}}"]}, "body": {"mode": "raw", "raw": "{\n  \"title\": \"New Task\",\n  \"description\": \"Task details\",\n  \"status\": \"todo\",\n  \"priority\": \"medium\",\n  \"dueDate\": \"2026-08-20T00:00:00.000Z\"\n}"}}}
      ]
    }
  ],
  "variable": [
    {"key": "accessToken", "value": ""},
    {"key": "refreshToken", "value": ""},
    {"key": "projectId", "value": ""}
  ]
}
