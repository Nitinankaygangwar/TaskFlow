// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Status {
  todo
  in_progress
  review
  done
}

enum Priority {
  low
  medium
  high
  urgent
}

enum PlatformRole {
  platform_admin
  user
}

enum OrgRole {
  org_admin
  member
}

model User {
  id            String        @id @default(uuid()) @db.Uuid
  name          String?       @db.VarChar(100)
  email         String?       @unique @db.VarChar(255)
  password      String?       @db.Text
  roleId        String?       @db.Uuid
  employeeId    String?       @db.VarChar(100)
  platformRole  PlatformRole  @default(user)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  // One user can belong to multiple organizations.
  memberships OrgMember[]

  refreshTokens RefreshToken[]

  // Projects created by this user.
  createdProjects Project[] @relation("ProjectCreatedBy")

  // Tasks created by this user.
  createdTasks Task[] @relation("TaskCreatedBy")

  // Tasks assigned to this user.
  assignments TaskAssignment[]

  // Users are often filtered by role or employeeId for admin queries.
  @@index([roleId])
  @@index([employeeId])
  @@map("users")
}

model Organization {
  id   String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(150)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  // Users belonging to this organization.
  members OrgMember[]

  refreshTokens RefreshToken[]

  // Projects belonging to this organization.
  projects Project[]

  tasks Task[]

  @@index([name])
  @@map("organizations")
}

model OrgMember {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  userId         String @db.Uuid
  role           OrgRole @default(member)

  joinedAt DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  comments Comment[]

  // Same user cannot join same organization twice.
  @@unique([organizationId, userId])
  // Used to fetch all members for an organization and to check membership quickly.
  @@index([organizationId])
  @@index([userId])
  @@map("org_members")
}

model RefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  organizationId String    @db.Uuid
  tokenHash      String    @db.Text
  expiresAt      DateTime  @db.Timestamptz(6)
  revokedAt      DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tokenHash])
  @@index([userId])
  @@index([organizationId])
  @@map("refresh_tokens")
}

model Project {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  createdBy      String @db.Uuid

  name        String  @db.VarChar(200)
  description String? @db.Text

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  creator User @relation("ProjectCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  tasks Task[]

  // Projects are commonly fetched organization-wise and by creator.
  @@index([organizationId])
  @@index([createdBy])
  @@map("projects")
}

model Task {
  id             String @id @default(uuid()) @db.Uuid
  projectId      String @db.Uuid
  organizationId String @db.Uuid
  createdBy      String @db.Uuid

  title       String  @db.VarChar(255)
  description String? @db.Text

  status   Status   @default(todo)
  priority Priority @default(medium)

  dueDate DateTime? @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  creator User @relation("TaskCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  assignments TaskAssignment[]
  comments    Comment[]

  // Tasks are commonly fetched project-wise and by org for multi-tenant access control.
  @@index([projectId])
  @@index([organizationId])
  @@index([createdBy])
  // Common task filtering and dashboard grouping by status/priority.
  @@index([status])
  @@index([priority])
  // Due-date queries are frequent for upcoming work and time windows.
  @@index([dueDate])
  @@map("tasks")
}

model TaskAssignment {
  id     String @id @default(uuid()) @db.Uuid
  taskId String @db.Uuid
  userId String @db.Uuid

  assignedAt DateTime @default(now()) @db.Timestamptz(6)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // Prevent assigning same user twice to same task.
  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
  @@map("task_assignments")
}

model Comment {
  id          String @id @default(uuid()) @db.Uuid
  taskId      String @db.Uuid
  orgMemberId String @db.Uuid

  content String @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  orgMember OrgMember @relation(fields: [orgMemberId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([taskId])
  @@index([orgMemberId])
  @@map("comments")
}
